# FinCore — Configuración del stack Docker
#
# Este archivo lo lee `docker compose` para sustituir variables en compose.yaml.
# La configuración interna de Laravel vive en backend/.env (separada a propósito).
#
# `scripts/install.sh` genera tu .env a partir de este template y autodetecta
# puertos libres: si APP_PORT=80 está ocupado, escribirá 81, etc.

# --- Puertos expuestos al host ---
# Dentro de la red Docker los servicios siguen escuchando sus puertos por
# defecto (80, 5173, 5432, 6379). Estos sólo controlan cómo se exponen al host.
APP_PORT=80
VITE_PORT=5173
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379

# --- Permisos dentro del contenedor api ---
# install.sh los rellena con tu `id -u` / `id -g` actuales para evitar
# problemas de ownership en archivos creados desde el contenedor.
WWWUSER=1000
WWWGROUP=1000

# --- Credenciales que usa el contenedor de Postgres al inicializar la DB ---
# IMPORTANTE: deben coincidir con DB_DATABASE / DB_USERNAME / DB_PASSWORD en
# backend/.env, porque Laravel se conecta a Postgres con esos valores.
DB_DATABASE=fincore
DB_USERNAME=postgres
DB_PASSWORD=password

# --- Xdebug ---
# Pon "debug" para depurar; "off" en uso normal (es lo que ahorra recursos).
SAIL_XDEBUG_MODE=off
