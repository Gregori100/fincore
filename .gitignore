# IDE / OS
.DS_Store
Thumbs.db
/.idea/
/.vscode/
/.zed/
/.nova/
/.fleet/

# Dependencies (root-level, e.g. npm workspaces)
/node_modules/
/vendor/

# Environment (raíz — usado por docker compose). .env.example sí se commitea.
/.env

# Test cache (PHPUnit deja esto fuera de backend/ si se corre desde la raíz)
/.phpunit.result.cache

# Playwright MCP artefactos (snapshots, console logs de smoke tests)
/.playwright-mcp/

# Output de los E2E (test-results/, reportes HTML, traces). El código sí se commitea.
/tests-e2e/test-results/
/tests-e2e/playwright-report/
/tests-e2e/blob-report/
/tests-e2e/.playwright-cache/
# Si por accidente Playwright se corre desde la raíz, crea test-results/ aquí.
/test-results/
/playwright-report/

# Each subproject handles its own ignores via backend/.gitignore and frontend/.gitignore
