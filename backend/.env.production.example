# Snapshot de variables de entorno para producción (Fly.io).
# Los valores marcados como SECRETO se setean con `fly secrets set` y NO van en
# texto plano al repo. Los demás los inyecta el [env] block del fly.toml.

APP_NAME=fincore
APP_ENV=production
APP_KEY=                       # SECRETO — `php artisan key:generate --show`
APP_DEBUG=false
APP_URL=https://fincore.fly.dev      # ajustar al subdomain real
FRONTEND_URL=https://fincore.fly.dev # mismo origen (SPA + API)

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

# Postgres en una app Fly aparte (fincore-db). El host .internal lo
# resuelve la red privada de Fly automáticamente.
DB_CONNECTION=pgsql
DB_HOST=fincore-db.internal
DB_PORT=5432
DB_DATABASE=fincore
DB_USERNAME=                   # SECRETO
DB_PASSWORD=                   # SECRETO

# Sin Redis en producción para simplificar. Sessions a Postgres, cache a disco,
# queue sync (los emails salen en la misma request, son pocos y rápidos).
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

# SMTP de Resend. La API key se setea con `fly secrets set MAIL_PASSWORD=re_...`.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_ENCRYPTION=ssl
MAIL_USERNAME=resend
MAIL_PASSWORD=                 # SECRETO — API key de Resend (re_...)
MAIL_FROM_ADDRESS="noreply@fincore.fly.dev"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
