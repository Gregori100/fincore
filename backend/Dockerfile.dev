# 1. Usar PHP 8.2+ para Laravel 12
FROM php:8.2-fpm-alpine

WORKDIR /var/www/html

# 2. Instalar extensiones necesarias (Añadido: pdo_mysql si usas MySQL)
ADD https://github.com/mlocati/docker-php-extension-installer/releases/latest/download/install-php-extensions /usr/local/bin/
RUN chmod +x /usr/local/bin/install-php-extensions && sync && \
    install-php-extensions pdo_pgsql pdo_mysql bcmath pgsql redis calendar imagick zip xsl gd intl opcache

# 3. Dependencias básicas
RUN apk add --no-cache \
    curl bash nginx supervisor git nodejs npm shadow

# 4. Configurar archivos (Asegúrate de que estas rutas existan en tu carpeta local)
COPY docker/nginx.conf /etc/nginx/nginx.conf
COPY docker/php.ini /usr/local/etc/php/php.ini
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY --from=composer:latest /usr/bin/composer /usr/local/bin/composer

# 5. Permisos
RUN chown -R www-data:www-data /var/www/html

EXPOSE 80

CMD ["/usr/bin/supervisord", "-c", "/etc/supervisor/conf.d/supervisord.conf"]