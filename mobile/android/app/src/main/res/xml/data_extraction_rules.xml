<?xml version="1.0" encoding="utf-8"?>
<!--
  FinCore es app local-first single-user con datos financieros sensibles.
  El flujo oficial de respaldo es Settings → Exportar JSON.
  Bloqueamos cloud-backup (Google Auto Backup) y device-transfer (transferencia
  cel-a-cel) para evitar exfiltración accidental de la BD SQLite. Ref RF-008.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
